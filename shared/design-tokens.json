{
  "meta": {
    "name": "Stride Design System",
    "version": "1.0.0",
    "source": "Logo-derived blue primary; teal accent; Nunito"
  },
  "colors": {
    "brand": {
      "primary": "#0058B8",
      "primaryHover": "#007BFF",
      "primaryPressed": "#004098",
      "primarySoft": "#E6F4FF",
      "primarySubtle": "#F0F7FC",
      "accent": "#00C6A7",
      "accentHover": "#14D8B5",
      "accentSoft": "#E6FBF7",
      "accentSubtle": "#F0FDF9"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#334155",
      "muted": "#64748B",
      "disabled": "#94A3B8",
      "inverse": "#FFFFFF"
    },
    "surface": {
      "page": "#F5F8FC",
      "card": "#FFFFFF",
      "elevated": "#FFFFFF",
      "subtle": "#F1F5F9",
      "interactive": "#E6F4FF",
      "inverse": "#0F172A"
    },
    "border": {
      "default": "#E2E8F0",
      "strong": "#CBD5E1",
      "focus": "#0058B8"
    },
    "semantic": {
      "success": "#16A34A",
      "successSoft": "#DCFCE7",
      "warning": "#F59E0B",
      "warningSoft": "#FEF3C7",
      "error": "#EF4444",
      "errorSoft": "#FEE2E2",
      "info": "#0284C7",
      "infoSoft": "#E0F2FE"
    }
  },
  "typography": {
    "fontFamily": "Nunito",
    "display": {
      "lg": { "size": 40, "weight": "800", "lineHeight": 1.15 },
      "md": { "size": 32, "weight": "800", "lineHeight": 1.2 },
      "sm": { "size": 28, "weight": "700", "lineHeight": 1.25 }
    },
    "h1": { "size": 28, "weight": "800", "lineHeight": 1.25 },
    "h2": { "size": 24, "weight": "700", "lineHeight": 1.3 },
    "h3": { "size": 20, "weight": "700", "lineHeight": 1.35 },
    "h4": { "size": 18, "weight": "600", "lineHeight": 1.4 },
    "bodyLarge": { "size": 18, "weight": "400", "lineHeight": 1.55 },
    "body": { "size": 16, "weight": "400", "lineHeight": 1.55 },
    "bodySmall": { "size": 14, "weight": "400", "lineHeight": 1.5 },
    "label": { "size": 14, "weight": "600", "lineHeight": 1.4 },
    "caption": { "size": 12, "weight": "500", "lineHeight": 1.4 }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 28,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "full": 999 },
  "shadow": {
    "none": "none",
    "sm": "0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04)",
    "md": "0 4px 16px rgba(15, 23, 42, 0.08)",
    "lg": "0 12px 40px rgba(15, 23, 42, 0.1)"
  },
  "control": { "heightSm": 36, "heightMd": 44, "heightLg": 52 },
  "zIndex": {
    "base": 1,
    "sticky": 50,
    "overlay": 100,
    "modal": 200,
    "toast": 300
  },
  "motion": { "fast": "120ms", "normal": "200ms", "slow": "320ms" },
  "density": {
    "patient": { "bodySize": 17, "sectionGap": 28 },
    "therapist": { "bodySize": 15, "sectionGap": 20 }
  }
}
