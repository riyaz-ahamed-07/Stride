# Copy to api/.env and fill from Supabase dashboard (Stride project only)
# postgresql:// is fine locally; the API rewrites it to postgresql+psycopg (psycopg3).
STRIDE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
STRIDE_SUPABASE_URL=https://PROJECT_REF.supabase.co
STRIDE_SUPABASE_PROJECT_REF=PROJECT_REF
# Local demo default. Use production to hide OTP/reset tokens from API JSON responses.
STRIDE_ENV=dev
# Optional. Overrides the documented development/demo seed password in app/seed.py.
# Do not put a real secret here and commit it.
# STRIDE_DEMO_PASSWORD=
STRIDE_PUBLIC_APP_URL=http://localhost:3001
# LiveKit Cloud or local livekit-server. API key/secret stay on the server.
# STRIDE_LIVEKIT_URL=wss://your-project.livekit.cloud
# STRIDE_LIVEKIT_API_KEY=
# STRIDE_LIVEKIT_API_SECRET=
# STRIDE_VIDEO_TOKEN_MINUTES=15
# Gmail SMTP (App Password — not your normal Gmail password):
# 1) Google Account → Security → 2-Step Verification (on)
# 2) App passwords → Mail → generate → paste 16-char password below
# STRIDE_SMTP_HOST=smtp.gmail.com
# STRIDE_SMTP_PORT=587
# STRIDE_SMTP_TLS=1
# STRIDE_SMTP_USER=you@gmail.com
# STRIDE_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# STRIDE_SMTP_FROM=you@gmail.com
# When SMTP is set, OTP + password-reset emails are sent; API hides dev_code in production.
