{
  "name": "stride-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start -c",
    "start:dev": "expo start --dev-client -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "setup:pose-models": "node scripts/download-pose-models.js",
    "build:dev:android": "eas build --platform android --profile development",
    "rebuild:dev:android": "npm run setup:pose-models && npm run prebuild:clean && eas build --platform android --profile development",
    "rebuild:local:android": "npm run setup:pose-models && npm run prebuild:clean && expo run:android"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "^2.2.12",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.47.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mediapipe-pose-plugin": "github:munishbp/react-native-mediapipe-pose-plugin",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
