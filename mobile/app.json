{
  "expo": {
    "name": "Stride",
    "slug": "stride-clinic",
    "version": "0.3.1",
    "orientation": "portrait",
    "scheme": "stride",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/icon.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "clinic.stride.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Stride uses the camera for guided exercises and video visits with your physiotherapist.",
        "NSMicrophoneUsageDescription": "Stride uses the microphone for your video visit with the physiotherapist."
      }
    },
    "android": {
      "package": "clinic.stride.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Stride uses the camera for guided exercises and video visits with your physiotherapist.",
          "enableMicrophonePermission": false
        }
      ],
      "./plugins/withMediaPipePose",
      [
        "expo-camera",
        {
          "cameraPermission": "Stride uses the camera for guided exercises and video visits with your physiotherapist.",
          "microphonePermission": "Stride uses the microphone for your video visit with the physiotherapist.",
          "recordAudioAndroid": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "10f16be7-5119-4dd4-a74f-d8523da6b3ab"
      }
    }
  }
}
