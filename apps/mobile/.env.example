# Set your laptop's LAN IP (same Wi‑Fi / hotspot as your phone).
# Find IP: ipconfig → IPv4 under Wi‑Fi (must be 192.168.x.x or 10.x.x.x — NOT 169.254.x.x)
#
# API must listen on all interfaces:
#   uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
#
# Then restart Expo so it picks up this file.
EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
